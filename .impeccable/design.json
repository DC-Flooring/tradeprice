  "components": [
    {
      "name": "Gold Button",
      "kind": "button",
      "refersTo": "button-gold-lg",
      "description": "The one primary action per screen; full width on phones.",
      "html": "<a class=\"ds-btn ds-btn-gold\" href=\"#\">Sign up free</a>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:58px;padding:0 28px;border-radius:16px;border:1px solid transparent;font:700 1.125rem/1 \"Inter\",system-ui,sans-serif;text-decoration:none;cursor:pointer;transition:transform 160ms cubic-bezier(0.23,1,0.32,1),background-color 200ms ease,border-color 200ms ease}.ds-btn:active{transform:scale(0.97);transition-duration:100ms}.ds-btn:focus-visible{outline:2px solid var(--gold,#B8924A);outline-offset:3px}.ds-btn-gold{background:var(--gold,#B8924A);color:var(--on-gold,#0B0A09)}.ds-btn-gold:hover,.ds-btn-gold:active{background:var(--gold-press,#A8833D)}"
    },
    {
      "name": "Outline Pill Button",
      "kind": "button",
      "refersTo": "button-outline-sm",
      "description": "Secondary action in the header (Sign in).",
      "html": "<a class=\"ds-btn-outline\" href=\"#\">Sign in</a>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 18px;border-radius:999px;border:1px solid var(--border-strong,#3A352E);background:transparent;color:var(--text,#F5F1E8);font:600 1rem/1 \"Inter\",system-ui,sans-serif;text-decoration:none;transition:transform 160ms cubic-bezier(0.23,1,0.32,1),background-color 200ms ease,border-color 200ms ease}.ds-btn-outline:hover{border-color:var(--text-2,#A8A196);background:var(--raised,#171512)}.ds-btn-outline:active{transform:scale(0.97);background:var(--raised,#171512);transition-duration:100ms}.ds-btn-outline:focus-visible{outline:2px solid var(--gold,#B8924A);outline-offset:3px}"
    },
    {
      "name": "Ink Button",
      "kind": "button",
      "refersTo": "button-ink",
      "description": "The only button allowed on the gold closing band.",
      "html": "<div class=\"ds-band\"><a class=\"ds-btn-ink\" href=\"#\">Sign up free</a></div>",
      "css": ".ds-band{background:var(--gold,#B8924A);padding:32px;display:grid;justify-items:center}.ds-btn-ink{display:inline-flex;align-items:center;justify-content:center;min-height:58px;width:100%;max-width:420px;padding:0 28px;border-radius:16px;background:var(--on-gold,#0B0A09);color:var(--gold,#B8924A);font:700 1.125rem/1 \"Inter\",system-ui,sans-serif;text-decoration:none;transition:transform 160ms cubic-bezier(0.23,1,0.32,1),background-color 200ms ease}.ds-btn-ink:hover{background:#1C1915}.ds-btn-ink:active{transform:scale(0.97);transition-duration:100ms}.ds-btn-ink:focus-visible{outline:2px solid var(--on-gold,#0B0A09);outline-offset:3px}"
    },
    {
      "name": "Header",
      "kind": "nav",
      "refersTo": "header",
      "description": "Sticky translucent bar with logo and Sign in, soft fade edge.",
      "html": "<header class=\"ds-header\"><span class=\"ds-logo\">DC FLOORING</span><a class=\"ds-pill\" href=\"#\">Sign in</a></header>",
      "css": ".ds-header{position:relative;display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:68px;padding:0 20px;background:rgba(11,10,9,0.72);backdrop-filter:blur(18px) saturate(160%)}.ds-header::after{content:\"\";position:absolute;left:0;right:0;top:100%;height:16px;background:linear-gradient(rgba(11,10,9,0.55),rgba(11,10,9,0));pointer-events:none}.ds-logo{font:700 1.5rem/1 \"Barlow Condensed\",sans-serif;color:var(--text,#F5F1E8)}.ds-pill{display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border-radius:999px;border:1px solid var(--border-strong,#3A352E);color:var(--text,#F5F1E8);font:600 1rem/1 \"Inter\",sans-serif;text-decoration:none}.ds-pill:hover{background:var(--raised,#171512)}.ds-pill:focus-visible{outline:2px solid var(--gold,#B8924A);outline-offset:3px}"
    },
    {
      "name": "Ruler",
      "kind": "custom",
      "refersTo": "",
      "description": "Gold tape-measure divider; the signature rule.",
      "html": "<div class=\"ds-ruler\" aria-hidden=\"true\"></div>",
      "css": ".ds-ruler{height:14px;opacity:0.85;background:repeating-linear-gradient(90deg,var(--gold,#B8924A) 0 2px,transparent 2px 50px) left bottom/100% 14px no-repeat,repeating-linear-gradient(90deg,var(--gold,#B8924A) 0 1px,transparent 1px 10px) left bottom/100% 6px no-repeat,linear-gradient(var(--gold,#B8924A),var(--gold,#B8924A)) left bottom/100% 1px no-repeat}"
    },
    {
      "name": "Price Screen",
      "kind": "card",
      "refersTo": "price-screen",
      "description": "The framed price list object with product rows and tier pill.",
      "html": "<div class=\"ds-screen\"><div class=\"ds-bar\"><span>Your prices</span><span class=\"ds-tier\">Trade</span></div><div class=\"ds-row\"><span class=\"ds-sw\"></span><span class=\"ds-main\"><span class=\"ds-name\">Twist pile carpet</span><span class=\"ds-stock\">In stock · cut today</span></span><span class=\"ds-pr\"><span class=\"ds-price\">£11.40</span><span class=\"ds-unit\">per m²</span></span></div></div>",
      "css": ".ds-screen{max-width:420px;background:var(--raised,#171512);border:1px solid var(--border,#2A2622);border-radius:24px;padding:18px 18px 6px;color:var(--text,#F5F1E8);font-family:\"Inter\",sans-serif;box-shadow:0 24px 60px -24px rgba(0,0,0,0.9),0 2px 0 rgba(255,255,255,0.03) inset}.ds-bar{display:flex;justify-content:space-between;align-items:center;padding-bottom:14px;font-size:0.9375rem;font-weight:600;color:var(--text-2,#A8A196)}.ds-tier{font-size:0.8125rem;font-weight:700;color:var(--on-gold,#0B0A09);background:var(--gold,#B8924A);padding:3px 10px;border-radius:999px}.ds-row{display:grid;grid-template-columns:52px minmax(0,1fr) auto;gap:14px;align-items:center;padding:14px 0;border-top:1px solid var(--border,#2A2622)}.ds-sw{width:52px;height:52px;border-radius:12px;background:#B9AE9C;box-shadow:inset 0 0 0 1px rgba(255,255,255,0.08)}.ds-main{display:grid;gap:2px}.ds-name{font-weight:600;font-size:1.0625rem;line-height:1.3}.ds-stock{font-weight:500;color:var(--ok,#8FD18F)}.ds-pr{display:grid;justify-items:end;line-height:1.15}.ds-price{font:600 1.5rem \"Barlow\",\"Inter\",sans-serif;letter-spacing:-0.01em;font-variant-numeric:tabular-nums lining-nums}.ds-unit{font-size:0.9375rem;color:var(--text-2,#A8A196)}"
    },
    {
      "name": "Chat Bubbles",
      "kind": "custom",
      "refersTo": "chat-out",
      "description": "Real-looking ring-ahead exchange.",
      "html": "<div class=\"ds-chat\"><p class=\"ds-msg ds-out\">4m x 5.2 of the grey twist for 2pm?</p><p class=\"ds-msg ds-in\"><span class=\"ds-from\">DC Flooring</span>Sorted. Cut and waiting.</p></div>",
      "css": ".ds-chat{display:grid;gap:6px;max-width:360px;font-family:\"Inter\",sans-serif}.ds-msg{position:relative;margin:0;max-width:88%;padding:7px 10px 8px 12px;border-radius:10px;font-size:1rem;line-height:1.35;color:var(--text,#F5F1E8)}.ds-out{justify-self:end;background:var(--chat-out,#0F5A45);border-top-right-radius:3px}.ds-in{justify-self:start;background:var(--chat-in,#24211D);border-top-left-radius:3px}.ds-out::after,.ds-in::after{content:\"\";position:absolute;top:0;width:8px;height:10px}.ds-out::after{right:-7px;background:var(--chat-out,#0F5A45);clip-path:polygon(0 0,100% 0,0 100%)}.ds-in::after{left:-7px;background:var(--chat-in,#24211D);clip-path:polygon(0 0,100% 0,100% 100%)}.ds-from{display:block;font-size:0.875rem;font-weight:700;color:var(--gold,#B8924A)}"
    },
    {
      "name": "Tier Staircase",
      "kind": "custom",
      "refersTo": "tier-gold",
      "description": "Three tiers, stacked under 600px, a staircase from 600px.",
      "html": "<ol class=\"ds-stairs\"><li class=\"ds-st ds-s1\"><b>Trade</b><span>From day one</span><i>Trade prices</i></li><li class=\"ds-st ds-s2\"><b>Trade Plus</b><span>For regulars</span><i>Better prices</i></li><li class=\"ds-st ds-s3\"><b>Trade Gold</b><span>Our biggest customers</span><i>Best prices</i></li></ol>",
      "css": ".ds-stairs{list-style:none;margin:0;padding:0;display:grid;gap:3px;font-family:\"Inter\",sans-serif;color:var(--text,#F5F1E8)}.ds-st{display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:16px;row-gap:2px;align-items:center;padding:18px;border-radius:6px}.ds-st b{grid-column:1;font:700 1.375rem/1 \"Barlow Condensed\",sans-serif;text-transform:uppercase;letter-spacing:0.02em}.ds-st span{grid-column:1;color:var(--text-3,#D6D0C4)}.ds-st i{grid-column:2;grid-row:1/span 2;font-style:normal;font-weight:600;color:var(--text-3,#D6D0C4)}.ds-s1{background:#2A2622}.ds-s2{background:#4A3D27}.ds-s2 i{color:#E2C58A}.ds-s3{background:var(--gold,#B8924A);color:var(--on-gold,#0B0A09)}.ds-s3 span{color:var(--on-gold-2,#2A2520)}.ds-s3 i{color:var(--on-gold,#0B0A09);font-weight:700}@media (min-width:600px){.ds-stairs{grid-template-columns:repeat(3,minmax(0,1fr));align-items:end}.ds-st{display:flex;flex-direction:column;align-items:flex-start;gap:4px;border-radius:6px 6px 0 0}.ds-st i{margin-top:auto}.ds-s1{min-height:172px}.ds-s2{min-height:232px}.ds-s3{min-height:300px}}"
    },
    {
      "name": "Voucher",
      "kind": "card",
      "refersTo": "voucher",
      "description": "Paper tear-off ticket with a notched stub.",
      "html": "<div class=\"ds-v\"><div class=\"ds-vb\"><h3>£50 off when you spend £500</h3><p>Vouchers land in your app. Just show it at the counter.</p><p class=\"ds-vl\">Member offers</p></div><div class=\"ds-vs\"><span>£50</span></div></div>",
      "css": ".ds-v{display:grid;grid-template-columns:minmax(0,1fr) 76px;max-width:420px;background:var(--paper,#F5F1E8);color:var(--on-gold,#0B0A09);border-radius:20px;overflow:hidden;box-shadow:0 20px 40px -20px rgba(0,0,0,0.8);font-family:\"Inter\",sans-serif}.ds-vb{padding:20px}.ds-vb h3{margin:0;font:700 1.875rem/1 \"Barlow Condensed\",sans-serif;text-transform:uppercase}.ds-vb p{margin:8px 0 0;color:var(--on-paper-2,#4A443B)}.ds-vb .ds-vl{margin-top:14px;font-size:0.9375rem;font-weight:700;color:#6B5A33}.ds-vs{position:relative;display:grid;place-items:center;background:var(--paper-2,#EDE6D8);border-left:2px dashed #C9C1B0}.ds-vs::before,.ds-vs::after{content:\"\";position:absolute;left:-11px;width:20px;height:20px;border-radius:50%;background:var(--raised,#171512)}.ds-vs::before{top:-10px}.ds-vs::after{bottom:-10px}.ds-vs span{font:400 2.25rem \"Auttera\",cursive;transform:rotate(-90deg);white-space:nowrap}"
    },
    {
      "name": "Toast",
      "kind": "custom",
      "refersTo": "toast",
      "description": "Paper status slip at the bottom; slides up, opacity only under reduced motion.",
      "html": "<div class=\"ds-toast\" role=\"status\">Call the counter on [Phone]</div>",
      "css": ".ds-toast{width:min(440px,calc(100% - 32px));padding:14px 18px;border-radius:16px;background:var(--paper,#F5F1E8);color:var(--on-gold,#0B0A09);font:500 1rem/1.4 \"Inter\",sans-serif;text-align:center;animation:ds-toast-in 260ms cubic-bezier(0.23,1,0.32,1)}@keyframes ds-toast-in{from{transform:translateY(calc(100% + 40px));opacity:0}to{transform:none;opacity:1}}@media (prefers-reduced-motion:reduce){.ds-toast{animation:ds-toast-fade 200ms ease}@keyframes ds-toast-fade{from{opacity:0}to{opacity:1}}}"
    }
  ],
  "narrative": {
    "northStar": "The Counter in Your Pocket",
    "overview": "The system is a trade counter seen from the van cab: a near-black ground, warm off-white type, and DC gold used the way a tape measure uses it, as rulings, ticks, numerals and dimension lines. Big Barlow Condensed capitals do the shouting, Barlow carries every number a fitter compares, Inter does the plain talking, and Auttera adds the odd pencil mark, as if someone at the counter jotted sizes on an offcut.\n\nLayout is open and ruled, not boxed. Sections sit straight on the dark ground and are separated by hairlines, gold top rules and the tape-measure ruler. The only framed things are things that are objects in real life: the price screen, the voucher, the sticker, the chat bubbles and the photos. The page ends on one solid band of gold. Density is generous on phones (designed at 390px) and opens into asymmetric two-column grids on desktop.\n\nMotion is almost absent. Controls give a small press response, the toast slides in, and the steam off the mug is the only thing that moves on its own.",
    "keyCharacteristics": [
      "Near-black van-cab ground (`van-cab-black`) with warm off-white text; dark colour scheme only.",
      "DC gold as lines, ticks and numerals; solid gold reserved for the main action, the tier pill, the Trade Gold tier and the closing band.",
      "Barlow Condensed 700 capitals for headlines; Barlow 600 tabular lining figures for prices and numerals; Inter for body; Auttera for short hand-written accents.",
      "Hairlines instead of cards; frames only for real-world objects.",
      "Real trade photos, rounded inline or full-bleed with fades.",
      "Press feedback only; the steam is the only loop."
    ],
    "rules": [
      {
        "name": "The Tape-Measure Rule",
        "body": "Gold is a line, a tick or a numeral first. Solid gold fills are limited to the main action, the tier pill, the top tier, text selection and the one closing band.",
        "section": "colors"
      },
      {
        "name": "The One Band Rule",
        "body": "A page ends on a single solid gold band holding its call to action. There is never a second gold band.",
        "section": "colors"
      },
      {
        "name": "The AA Floor Rule",
        "body": "Every text pairing measures at least 4.5:1. The lowest shipped text pairing is 5.2:1 (secondary text on gold). New pairings get measured before they ship.",
        "section": "colors"
      },
      {
        "name": "The Capitals Rule",
        "body": "Barlow Condensed is only ever 700, only ever in capitals, only ever a headline or a name.",
        "section": "typography"
      },
      {
        "name": "The Figures Rule",
        "body": "Any number someone compares (prices, quantities, step numbers, minutes) is set in Barlow with tabular lining figures.",
        "section": "typography"
      },
      {
        "name": "The Pencil Rule",
        "body": "Auttera is for short hand-written accents of one to three words: a script headline line, pencil notes, dimension labels, the voucher stub, the sticker. Never body text, never a button, never the only carrier of information a fitter needs.",
        "section": "typography"
      },
      {
        "name": "The 16px Floor Rule",
        "body": "Body and supporting text is at least 1rem (16px).",
        "section": "typography"
      },
      {
        "name": "The Real Object Rule",
        "body": "Only things that exist as objects in life get a frame, radius and shadow: screens, vouchers, stickers, chat bubbles, photos. Everything else sits flat on hairlines.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep every tap target at least 44px tall (the `tap` spacing token), including text links.",
      "Do keep body and supporting text at 16px or more and every text pairing at WCAG AA (4.5:1) or better, measured.",
      "Do use one gold primary button per screen, and end the page on one gold band with an Ink button.",
      "Do separate content with hairlines, gold top rules, the ruler or a change of ground.",
      "Do set every comparable number in Barlow 600 with tabular lining figures.",
      "Do limit press feedback to scale 0.97 and a colour change, and gate hover styles to fine pointers.",
      "Do ship photos as WebP plus JPG at 800px and full size, lazy-loaded, with width and height set.",
      "Do write in British English, in short sentences, with no em dashes. Unknown facts stay as visible [square bracket] placeholders, such as [Phone] or [7:30am].",
      "Do honour reduced motion, reduced transparency and higher contrast as described above."
    ],
    "donts": [
      "Don't wrap sections or lists in rounded cards. Frames, radius and shadow belong only to real-world objects.",
      "Don't add eyebrow labels or small kicker text above headlines.",
      "Don't set Barlow Condensed in lower case or at any weight but 700.",
      "Don't use Auttera for body copy, buttons or anything a fitter needs to read to act.",
      "Don't animate anything except the tea steam.",
      "Don't use stock photos, real manufacturer names, logos or club badges.",
      "Don't add a second solid gold band or fill large areas with gold.",
      "Don't invent quotes, reviews, prices or stock figures; show sample data as examples."
    ]
  }
}